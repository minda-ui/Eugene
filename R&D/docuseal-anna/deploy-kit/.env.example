# RND-8 DocuSeal — environment template. COPY to `.env` and fill with REAL values.
# The real `.env` is git-ignored and NEVER committed. Minda holds all of these (charter §3).
# Eugene never types or stores the real values — these are placeholders only.

# Public hostname the signing links use (must resolve to the HQ FTTB public IP + reach Caddy :443)
PUBLIC_HOST=sign.fishboneconstruction.co.uk

# Postgres password for the docuseal DB user. Generate a strong one, store in Minda's vault.
#   e.g.  openssl rand -base64 24
DB_PASSWORD=__CHANGE_ME__strong_db_password__

# Rails secret key base for DocuSeal. Generate once, keep it stable (losing it invalidates sessions).
#   openssl rand -hex 64
SECRET_KEY_BASE=__CHANGE_ME__64_byte_hex__

# --- Option B (Pro self-host) only -----------------------------------------------------------
# If you go Pro, put the DocuSeal Pro licence key here and uncomment LICENSE_KEY in compose.
# Confirm the EXACT variable name against DocuSeal's self-host Pro docs at deploy time.
# DOCUSEAL_LICENSE_KEY=__CHANGE_ME__pro_licence_key__

# --- SMTP (only if setting email via env rather than DocuSeal's Settings -> Email UI) ---------
# Recommended: configure SMTP in the DocuSeal admin UI after first boot (simpler, fewer unknowns).
# If using env, confirm DocuSeal's current SMTP_* variable names against their docs, then set them
# here and reference them in compose. A dedicated sender (Workspace SMTP relay / app-password
# account) is best. SMTP creds are a secret — Minda-held.
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@fishboneconstruction.co.uk
